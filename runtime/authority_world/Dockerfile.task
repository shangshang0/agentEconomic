ARG DOCKER_REGISTRY=docker.m.daocloud.io
FROM ${DOCKER_REGISTRY}/library/debian:bookworm-slim
ARG APT_MIRROR=http://mirrors.aliyun.com/debian
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i "s|http://deb.debian.org/debian|${APT_MIRROR}|g; s|http://deb.debian.org/debian-security|${APT_MIRROR}-security|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
        bash coreutils file binutils grep ripgrep sed findutils diffutils \
        tar gzip bzip2 xz-utils unzip zip p7zip-full xxd jq \
        gcc g++ make libc6-dev gdb strace patchelf qemu-user \
        tcpdump tshark libjxl-tools apktool sleuthkit netcat-openbsd socat sqlite3 openssl clamav \
        sagemath \
        python3 python3-numpy python3-sympy python3-z3 python3-fpylll python3-pil python3-matplotlib \
        python3-pycryptodome python3-cryptography python3-pefile python3-capstone \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home --shell /usr/sbin/nologin taskuser \
    && install -d -o 10001 -g 10001 -m 0700 /work
RUN ln -s /usr/lib/python3/dist-packages/Cryptodome /usr/lib/python3/dist-packages/Crypto
USER 10001:10001
WORKDIR /work
CMD ["sleep", "infinity"]
