import AgentMicrofoundations.AutoregressiveResponse
import AgentMicrofoundations.TokenAccounting
import AgentMicrofoundations.Accounting

/-!
Canonical composition layer for agent-centered economic prediction.

An admissible computational economy combines (1) a persistent autoregressive
constitution whose parsed trace law equals the model's individual response
law, (2) an explicit joint response law whose cross-agent dependence is left
unrestricted except for those marginals, and (3) an institution compatible
with the model's feasible execution set. Production, resource accounting, and
state/context updating remain explicit model primitives. The period law is
therefore computable from these primitives without a utility or rationality
axiom, while its empirical applicability still requires identifying the
conditional kernels.
-/
namespace AgentMicrofoundations.ComputationalEconomy

open AgentMicrofoundations.Ontology
open AgentMicrofoundations.AutoregressiveResponse
open AgentMicrofoundations.TokenAccounting
open AgentMicrofoundations.Accounting

/-- A computational agent economy ties the individual response marginals to a
    fixed autoregressive constitution while retaining an unrestricted joint
    response dependence structure and an explicitly admissible institution. -/
structure ComputationalAgentEconomy
    (Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Proposal Production : Type)
    [DecidableEq Proposal] where
  model : AgentEconomyModel Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Proposal Production
  constitution : ResponseKernelRepresentation model
  institution : AdmissibleInstitution model

/-- Joint proposal law for the computational economy at a condition and full
    population state. Dependence among agents is inherited from the model's
    joint response kernel; no product factorization is imposed. -/
def proposalLaw
    {Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Proposal Production : Type}
    [DecidableEq Proposal]
    (economy : ComputationalAgentEconomy Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Proposal Production)
    (condition : Condition)
    (states : StateProfile Agent InternalState ResourceState) :
    FiniteDistribution (ProposalProfile Agent Proposal) :=
  proposalDistribution economy.model economy.institution.rule condition states

/-- Exact one-period prediction law for an admissible computational economy:
    joint proposals, institutional execution, joint production, and the updated
    internal/resource states. This is an executable distribution once the
    conditional kernels and ledgers are supplied. -/
def periodLaw
    {Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Proposal Production : Type}
    [DecidableEq Proposal]
    (economy : ComputationalAgentEconomy Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Proposal Production)
    (condition : Condition)
    (states : StateProfile Agent InternalState ResourceState) :=
  admissibleOnePeriodDistribution economy.model economy.institution condition states

/-- The marginal of the population proposal lottery for any named agent is
    exactly the proposal law generated by that agent's fixed token transition,
    prompt encoder, state-conditioned budget, and parser. Cross-agent dependence
    stays free in the joint law. This is the main bridge from computational
    constitution to population-level economic outcomes. -/
theorem joint_proposal_marginal_is_autoregressive
    {Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Proposal Production : Type}
    [DecidableEq Proposal]
    (economy : ComputationalAgentEconomy Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Proposal Production)
    (condition : Condition)
    (states : StateProfile Agent InternalState ResourceState)
    (agent : Agent) (action : Proposal) :
    eventMass (proposalLaw economy condition states)
      (fun profile => decide (profile agent = action)) =
    eventMass
      (mapDistribution (economy.constitution.parseProposal agent)
        (generatedTokenTrace
          (economy.constitution.nextToken agent)
          (economy.constitution.stopToken agent)
          (economy.constitution.generationBudget agent (states agent))
          (economy.constitution.prompt agent condition (states agent)
            (economy.model.observe agent (states agent) condition)
            (economy.institution.rule.institutionalSignal condition states agent)
            (economy.model.opportunityMenu agent (states agent) condition))))
      (fun proposal => decide (proposal = action)) := by
  unfold proposalLaw proposalDistribution
  rw [economy.model.responseMarginalsAgree agent condition states
    (fun current => economy.model.observe current (states current) condition)
    (fun current => economy.institution.rule.institutionalSignal condition states current)
    (fun current => economy.model.opportunityMenu current (states current) condition)
    action]
  rw [economy.constitution.responseFactorization agent condition (states agent)
    (economy.model.observe agent (states agent) condition)
    (economy.institution.rule.institutionalSignal condition states agent)
    (economy.model.opportunityMenu agent (states agent) condition)]

/-- A resource-coupled computational economy specializes the general model to
    proposals that retain their generated token traces. Its token budget is
    derived from the tracked subject's own spendable balance; its mechanism is
    admissible; and resource updates close against an explicit event ledger.
    The parser-preservation condition prevents the response representation
    from silently discarding or rewriting the trace used for cost accounting.
    The generation-cost event condition connects realized computation to the
    ledger, including when the institution later rejects a proposal. -/
structure ResourceCoupledComputationalEconomy
    (Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Action Token Production Resource : Type)
    [DecidableEq Agent] [DecidableEq Action] [DecidableEq Token] [DecidableEq Resource]
    where
  model : AgentEconomyModel Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity
    (TraceCarryingProposal Action Token) Production
  response : ResourceBoundedResponseProcess model
  institution : AdmissibleInstitution model
  ledger : ResourceAccounting (Resource := Resource) model
  tokenResource : Resource
  parserPreservesTrace : ∀ agent {budget : Nat} (trace : BudgetedTokenTrace response.response.Token budget),
    (response.response.parseProposal agent trace).generatedTokens.length = trace.tokens.length ∧
    (response.response.parseProposal agent trace).generationBudget = budget
  generationCostRecorded : ∀ agent condition states proposals execution production,
    ResourceEvent.operatingCost tokenResource agent
      (response.tokenPrice * (proposals agent).generatedTokens.length) ∈
        ledger.events condition states proposals execution production

/-- A trace actually parsed by the resource-bounded response process cannot
    consume more token-denominated resource than the subject's initial balance.
    This is the central constitutive resource-computation link: resources cap
    autoregressive work, and parser-preserved realized work is charged at the
    same unit price. It is conditional on the trace being generated by this
    process; it is not a choice or productivity prediction. -/
theorem generated_trace_charge_fits_subject_balance
    {Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Action Token Production Resource : Type}
    [DecidableEq Agent] [DecidableEq Action] [DecidableEq Token] [DecidableEq Resource]
    (economy : ResourceCoupledComputationalEconomy Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Action Token Production Resource)
    (agent : Agent) (state : AgentState InternalState ResourceState)
    (trace : BudgetedTokenTrace economy.response.response.Token
      (economy.response.response.generationBudget agent state)) :
    realizedGenerationCharge economy.response.tokenPrice
        (economy.response.response.parseProposal agent trace) ≤
      economy.response.tokenBalance state.resources := by
  rcases economy.parserPreservesTrace agent trace with ⟨tracePreserved, _budgetPreserved⟩
  have maximumAffordable := resource_bounded_generation_fits_account
    economy.response agent state
  unfold realizedGenerationCharge
  rw [tracePreserved]
  calc
    economy.response.tokenPrice * trace.tokens.length ≤
        economy.response.tokenPrice *
          economy.response.response.generationBudget agent state :=
      Nat.mul_le_mul_left _ trace.withinBudget
    _ ≤ economy.response.tokenBalance state.resources := maximumAffordable

end AgentMicrofoundations.ComputationalEconomy
