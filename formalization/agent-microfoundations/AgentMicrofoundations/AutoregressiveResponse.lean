import AgentMicrofoundations.Ontology
import AgentMicrofoundations.ContextualResponse
import AgentMicrofoundations.ResponseIdentification

/-!
Autoregressive microfoundation of a computational agent's proposal law.

A constitution is represented by a fixed next-token kernel and a fixed action
parser. The prompt/context determines the initial token prefix. The finite
output law is generated by repeatedly applying the same conditional kernel;
no utility maximization or preference stability assumption is used. The
fixed horizon represents a generation budget (including any explicit stop
token convention chosen by an application).
-/
namespace AgentMicrofoundations.AutoregressiveResponse

open AgentMicrofoundations.Ontology
open AgentMicrofoundations.ContextualResponse

/-- Distribution over the next token conditional on the complete prefix.
    Sampling/decoding randomness is part of this kernel. -/
abbrev NextTokenKernel (Token : Type) :=
  List Token → FiniteDistribution Token

/-- An application can use this proposal representation when generated-token
    use is economically attributable. Keeping the trace alongside the parsed
    action lets the model charge actual realized computation even if the
    institution later rejects the proposal. Whether such a charge belongs to
    the agent's own ledger is an application-level ownership condition. -/
structure TraceCarryingProposal (Action Token : Type) where
  action : Action
  generatedTokens : List Token
  generationBudget : Nat
  withinBudget : generatedTokens.length ≤ generationBudget
  deriving DecidableEq

 /-- A generated trace carries a proof that it respects its configured maximum
     generation budget. Storing this proof prevents later accounting code
     from silently treating an arbitrary, over-budget string as an output of
     the represented process. -/
structure BudgetedTokenTrace (Token : Type) (budget : Nat) where
  tokens : List Token
  withinBudget : tokens.length ≤ budget

def proposalWithTrace {Action Token : Type} {budget : Nat}
    (parseAction : List Token → Action)
    (trace : BudgetedTokenTrace Token budget) : TraceCarryingProposal Action Token :=
  ⟨parseAction trace.tokens, trace.tokens, budget, trace.withinBudget⟩

def generatedTokenCount {Action Token : Type}
    (proposal : TraceCarryingProposal Action Token) : Nat :=
  proposal.generatedTokens.length

/-- The finite-horizon distribution of newly generated tokens. At each step,
    the next-token kernel is evaluated at the prompt followed by all tokens
    already generated. A designated stop token ends generation early and is
    included in the realized trace; the horizon is a maximum token budget. -/
def extendGeneratedTrace {Token : Type}
    (stopToken : Token → Bool) (steps : Nat) (token : Token)
    (suffixLaw : FiniteDistribution (BudgetedTokenTrace Token steps)) :
    FiniteDistribution (BudgetedTokenTrace Token (steps + 1)) :=
  if stopToken token then
    pureDistribution ⟨[token], by simp⟩
  else
    mapDistribution (fun suffix =>
      ⟨token :: suffix.tokens, by
        have tailBound := suffix.withinBudget
        simp only [List.length_cons]
        omega⟩) suffixLaw

def generatedTokenTrace {Token : Type}
    (nextToken : NextTokenKernel Token) (stopToken : Token → Bool) :
    (budget : Nat) → List Token →
      FiniteDistribution (BudgetedTokenTrace Token budget)
  | 0, _ => pureDistribution ⟨[], Nat.zero_le _⟩
  | steps + 1, promptPrefix =>
      bindDistribution (nextToken promptPrefix) (fun token =>
        extendGeneratedTrace stopToken steps token
          (generatedTokenTrace nextToken stopToken steps (promptPrefix ++ [token])))

/-- The first generated token, when a finite-horizon trace is nonempty. -/
def firstGeneratedToken {Token : Type} {budget : Nat}
    (trace : BudgetedTokenTrace Token budget) : Option Token :=
  trace.tokens.head?

theorem eventMass_of_constant_event {Outcome : Type}
    (distribution : FiniteDistribution Outcome) (event : Outcome → Bool)
    (value : Bool) (constant : ∀ outcome, event outcome = value) :
    eventMass distribution event = if value then 1 else 0 := by
  cases value
  · unfold eventMass
    induction distribution.outcomes with
    | nil => rfl
    | cons entry rest ih =>
        rcases entry with ⟨outcome, weight⟩
        simp [constant outcome, ih]
  · unfold eventMass
    have allTrue : distribution.outcomes.foldr
        (fun outcome total => if event outcome.1 then outcome.2 + total else total) 0 =
          mass distribution.outcomes := by
      induction distribution.outcomes with
      | nil => rfl
      | cons entry rest ih =>
          rcases entry with ⟨outcome, weight⟩
          simp only [List.foldr_cons, mass]
          rw [constant outcome, if_pos rfl, ih]
    rw [allTrue, distribution.normalized]
    simp

/-- Stopping or continuing cannot change the first generated token: every
    continuation prepends the sampled token, and a stop emits that token as
    the entire trace. -/
theorem first_token_step_law {Token : Type}
    (stopToken : Token → Bool) (steps : Nat) (token : Token)
    (suffixLaw : FiniteDistribution (BudgetedTokenTrace Token steps))
    (event : Option Token → Bool) :
    eventMass (extendGeneratedTrace stopToken steps token suffixLaw)
      (fun trace => event (firstGeneratedToken trace)) =
      eventMass
        (pureDistribution (⟨[token], by simp⟩ :
          BudgetedTokenTrace Token (steps + 1)))
        (fun trace => event (firstGeneratedToken trace)) := by
  by_cases stopped : stopToken token
  · simp [extendGeneratedTrace, stopped]
  · rw [extendGeneratedTrace, if_neg stopped]
    rw [eventMass_mapDistribution]
    have constant : ∀ suffix : BudgetedTokenTrace Token steps,
        event (firstGeneratedToken
          (⟨token :: suffix.tokens, by
            have tailBound := suffix.withinBudget
            simp only [List.length_cons]
            omega⟩ :
            BudgetedTokenTrace Token (steps + 1))) = event (some token) := by
      intro suffix
      rfl
    rw [eventMass_of_constant_event _ _ (event (some token)) constant]
    simp [firstGeneratedToken, eventMass, pureDistribution, Rat.add_zero]

/-- Prefix identification for an autoregressive subject: for any positive
    generation budget, the first-token event probabilities equal those of the
    fixed next-token kernel at the same prompt. Thus resource-induced changes
    to the maximum horizon cannot alter the first generated token when the
    prompt and token kernel are held fixed. Later tokens and parsed proposals
    may still change. -/
theorem first_token_law_independent_of_positive_budget {Token : Type}
    (nextToken : NextTokenKernel Token) (stopToken : Token → Bool)
    (budget : Nat) (promptPrefix : List Token) (positiveBudget : 0 < budget) :
    ∀ event : Option Token → Bool,
      eventMass
          (mapDistribution firstGeneratedToken
            (generatedTokenTrace nextToken stopToken budget promptPrefix)) event =
        eventMass (mapDistribution some (nextToken promptPrefix)) event := by
  cases budget with
  | zero => omega
  | succ steps =>
      intro event
      change eventMass
          (mapDistribution firstGeneratedToken
            (bindDistribution (nextToken promptPrefix)
              (fun token => extendGeneratedTrace stopToken steps token
                (generatedTokenTrace nextToken stopToken steps
                  (promptPrefix ++ [token])))))
          event =
        eventMass (mapDistribution some (nextToken promptPrefix)) event
      rw [eventMass_mapDistribution, eventMass_bindDistribution]
      calc
        weightedContextEventMass (nextToken promptPrefix).outcomes
            (fun token => extendGeneratedTrace stopToken steps token
              (generatedTokenTrace nextToken stopToken steps
                (promptPrefix ++ [token])))
            (fun trace => event (firstGeneratedToken trace)) =
          weightedContextEventMass (nextToken promptPrefix).outcomes
            (fun token => pureDistribution
              (⟨[token], by simp⟩ : BudgetedTokenTrace Token (steps + 1)))
            (fun trace => event (firstGeneratedToken trace)) := by
              apply weightedContextEventMass_congr
              intro token
              exact first_token_step_law stopToken steps token
                (generatedTokenTrace nextToken stopToken steps (promptPrefix ++ [token])) event
        _ = eventMass (nextToken promptPrefix)
              (fun token => event (some token)) := by
                rw [weightedContextEventMass_pure]
                rw [eventMassList_eq_foldr]
                rfl
        _ = eventMass (mapDistribution some (nextToken promptPrefix)) event := by
              symm
              exact eventMass_mapDistribution some (nextToken promptPrefix) event

/-- Any prefix that fits within the generation horizon has a law independent
    of the larger horizon. Autoregressive generation samples each token from
    the same conditional kernel at the same realized prefix; extra budget only
    governs continuation after the requested prefix. Early stopping is retained
    in the prefix, so stop-token behavior is part of the observable law. -/
theorem token_prefix_law_independent_of_larger_budget {Token : Type}
    (nextToken : NextTokenKernel Token) (stopToken : Token → Bool)
    (prefixLength budget : Nat) (promptPrefix : List Token)
    (budgetCoversPrefix : prefixLength ≤ budget) :
    ∀ event : List Token → Bool,
      eventMass
          (mapDistribution (fun trace => trace.tokens.take prefixLength)
            (generatedTokenTrace nextToken stopToken budget promptPrefix)) event =
        eventMass
          (mapDistribution (fun trace => trace.tokens.take prefixLength)
            (generatedTokenTrace nextToken stopToken prefixLength promptPrefix)) event := by
  induction prefixLength generalizing budget promptPrefix with
  | zero =>
      intro event
      have leftConstant : ∀ trace : BudgetedTokenTrace Token budget,
          event (trace.tokens.take 0) = event [] := by
        intro trace
        simp
      have rightConstant : ∀ trace : BudgetedTokenTrace Token 0,
          event (trace.tokens.take 0) = event [] := by
        intro trace
        simp
      rw [eventMass_mapDistribution]
      rw [eventMass_of_constant_event _ _ (event []) leftConstant]
      rw [eventMass_mapDistribution]
      rw [eventMass_of_constant_event _ _ (event []) rightConstant]
  | succ prefixLength ih =>
      cases budget with
      | zero => omega
      | succ budgetTail =>
          have tailCoversPrefix : prefixLength ≤ budgetTail := by omega
          intro event
          change eventMass
              (mapDistribution (fun trace => trace.tokens.take (prefixLength + 1))
                (bindDistribution (nextToken promptPrefix) (fun token =>
                  extendGeneratedTrace stopToken budgetTail token
                    (generatedTokenTrace nextToken stopToken budgetTail
                      (promptPrefix ++ [token]))))) event =
            eventMass
              (mapDistribution (fun trace => trace.tokens.take (prefixLength + 1))
                (bindDistribution (nextToken promptPrefix) (fun token =>
                  extendGeneratedTrace stopToken prefixLength token
                    (generatedTokenTrace nextToken stopToken prefixLength
                      (promptPrefix ++ [token]))))) event
          calc
            eventMass
                (mapDistribution (fun trace => trace.tokens.take (prefixLength + 1))
                  (bindDistribution (nextToken promptPrefix) (fun token =>
                    extendGeneratedTrace stopToken budgetTail token
                      (generatedTokenTrace nextToken stopToken budgetTail
                        (promptPrefix ++ [token]))))) event =
              weightedContextEventMass (nextToken promptPrefix).outcomes
                (fun token => mapDistribution
                  (fun trace => trace.tokens.take (prefixLength + 1))
                  (extendGeneratedTrace stopToken budgetTail token
                    (generatedTokenTrace nextToken stopToken budgetTail
                      (promptPrefix ++ [token])))) event := by
                  exact eventMass_map_bindDistribution (nextToken promptPrefix)
                    (fun token => extendGeneratedTrace stopToken budgetTail token
                      (generatedTokenTrace nextToken stopToken budgetTail
                        (promptPrefix ++ [token])))
                    (fun trace => trace.tokens.take (prefixLength + 1)) event
            _ = weightedContextEventMass (nextToken promptPrefix).outcomes
                  (fun token => mapDistribution
                    (fun trace => trace.tokens.take (prefixLength + 1))
                    (extendGeneratedTrace stopToken prefixLength token
                      (generatedTokenTrace nextToken stopToken prefixLength
                        (promptPrefix ++ [token])))) event := by
                  apply weightedContextEventMass_congr
                    (contexts := (nextToken promptPrefix).outcomes)
                    (first := fun token => mapDistribution
                      (fun trace => trace.tokens.take (prefixLength + 1))
                      (extendGeneratedTrace stopToken budgetTail token
                        (generatedTokenTrace nextToken stopToken budgetTail
                          (promptPrefix ++ [token]))))
                    (second := fun token => mapDistribution
                      (fun trace => trace.tokens.take (prefixLength + 1))
                      (extendGeneratedTrace stopToken prefixLength token
                        (generatedTokenTrace nextToken stopToken prefixLength
                          (promptPrefix ++ [token]))))
                    (event := event)
                  intro token
                  by_cases stopped : stopToken token
                  · simp [extendGeneratedTrace, stopped, mapDistribution, pureDistribution, eventMass]
                    rfl
                  · simp only [extendGeneratedTrace, if_neg stopped]
                    calc
                      eventMass
                          (mapDistribution (fun trace => trace.tokens.take (prefixLength + 1))
                            (mapDistribution (fun suffix =>
                              (⟨token :: suffix.tokens, by
                                have tailBound := suffix.withinBudget
                                simp only [List.length_cons]
                                omega⟩ : BudgetedTokenTrace Token (budgetTail + 1)))
                              (generatedTokenTrace nextToken stopToken budgetTail
                                (promptPrefix ++ [token])))) event =
                        eventMass (mapDistribution (fun suffix => suffix.tokens.take prefixLength)
                          (generatedTokenTrace nextToken stopToken budgetTail
                            (promptPrefix ++ [token]))) (fun tokens => event (token :: tokens)) := by
                          rw [eventMass_mapDistribution, eventMass_mapDistribution]
                          simp [List.take_succ_cons]
                          exact (eventMass_mapDistribution
                            (fun suffix => suffix.tokens.take prefixLength)
                            (generatedTokenTrace nextToken stopToken budgetTail
                              (promptPrefix ++ [token]))
                            (fun tokens => event (token :: tokens))).symm
                      _ = eventMass
                          (mapDistribution (fun suffix => suffix.tokens.take prefixLength)
                            (generatedTokenTrace nextToken stopToken prefixLength
                              (promptPrefix ++ [token]))) (fun tokens => event (token :: tokens)) :=
                        ih budgetTail (promptPrefix ++ [token]) tailCoversPrefix
                          (fun tokens => event (token :: tokens))
                      _ = eventMass
                          (mapDistribution (fun trace => trace.tokens.take (prefixLength + 1))
                            (mapDistribution (fun suffix =>
                              (⟨token :: suffix.tokens, by
                                have tailBound := suffix.withinBudget
                                simp only [List.length_cons]
                                omega⟩ : BudgetedTokenTrace Token (prefixLength + 1)))
                              (generatedTokenTrace nextToken stopToken prefixLength
                                (promptPrefix ++ [token])))) event := by
                          rw [eventMass_mapDistribution, eventMass_mapDistribution]
                          rw [eventMass_mapDistribution]
                          simp [List.take_succ_cons]
            _ = eventMass
                (mapDistribution (fun trace => trace.tokens.take (prefixLength + 1))
                  (bindDistribution (nextToken promptPrefix) (fun token =>
                    extendGeneratedTrace stopToken prefixLength token
                      (generatedTokenTrace nextToken stopToken prefixLength
                        (promptPrefix ++ [token]))))) event := by
                  symm
                  exact eventMass_map_bindDistribution (nextToken promptPrefix)
                    (fun token => extendGeneratedTrace stopToken prefixLength token
                      (generatedTokenTrace nextToken stopToken prefixLength
                        (promptPrefix ++ [token])))
                    (fun trace => trace.tokens.take (prefixLength + 1)) event


/-- A computational constitution fixes token generation and the protocol
    parser. A context supplies the initial prompt prefix; it is not encoded as
    a preference or a rationality assumption. -/
structure AutoregressiveConstitution (Context Token Proposal : Type) where
  prompt : Context → List Token
  nextToken : NextTokenKernel Token
  stopToken : Token → Bool
  parseProposal : {budget : Nat} → BudgetedTokenTrace Token budget → Proposal

/-- Proposal distribution induced by the fixed autoregressive constitution,
    an initial context, and a finite generation budget. -/
def proposalLaw {Context Token Proposal : Type}
    (constitution : AutoregressiveConstitution Context Token Proposal)
    (context : Context) (generationBudget : Nat) :
    FiniteDistribution Proposal :=
  mapDistribution constitution.parseProposal
    (generatedTokenTrace constitution.nextToken constitution.stopToken generationBudget
      (constitution.prompt context))

/-- Approximation error of representing a proposal by a decoder that only sees
    the first `prefixLength` generated tokens. This is a trace probability, not
    a uniform worst-case claim; it can be measured for each budget. -/
def prefixParserDisagreementMass
    {Context Token Proposal : Type} [DecidableEq Proposal]
    (constitution : AutoregressiveConstitution Context Token Proposal)
    (context : Context) (generationBudget prefixLength : Nat)
    (prefixParser : List Token → Proposal) : Rat :=
  eventMass
    (generatedTokenTrace constitution.nextToken constitution.stopToken generationBudget
      (constitution.prompt context))
    (fun trace => decide
      (constitution.parseProposal trace ≠ prefixParser (trace.tokens.take prefixLength)))

/-- A full parser and its prefix-only approximation differ on any proposal
    event by at most the probability that they disagree on the generated trace.
    This gives a quantitative route to use the exact prefix invariance theorem
    even when the application parser is only approximately prefix-sufficient. -/
theorem proposal_event_within_prefix_parser_disagreement
    {Context Token Proposal : Type} [DecidableEq Proposal]
    (constitution : AutoregressiveConstitution Context Token Proposal)
    (context : Context) (generationBudget prefixLength : Nat)
    (prefixParser : List Token → Proposal) (event : Proposal → Bool) :
    (eventMass (proposalLaw constitution context generationBudget) event ≤
        eventMass
          (mapDistribution prefixParser
            (mapDistribution (fun trace : BudgetedTokenTrace Token generationBudget =>
              trace.tokens.take prefixLength)
              (generatedTokenTrace constitution.nextToken constitution.stopToken
                generationBudget (constitution.prompt context)))) event +
          prefixParserDisagreementMass constitution context generationBudget prefixLength
            prefixParser) ∧
      (eventMass
          (mapDistribution prefixParser
            (mapDistribution (fun trace : BudgetedTokenTrace Token generationBudget =>
              trace.tokens.take prefixLength)
              (generatedTokenTrace constitution.nextToken constitution.stopToken
                generationBudget (constitution.prompt context)))) event ≤
        eventMass (proposalLaw constitution context generationBudget) event +
          prefixParserDisagreementMass constitution context generationBudget prefixLength
            prefixParser) := by
  let traceLaw := generatedTokenTrace constitution.nextToken constitution.stopToken
    generationBudget (constitution.prompt context)
  have comparison :=
    AgentMicrofoundations.ResponseIdentification.event_probability_difference_bounded_by_mismatch
      traceLaw constitution.parseProposal
      (fun trace : BudgetedTokenTrace Token generationBudget =>
        prefixParser (trace.tokens.take prefixLength)) event
  simpa [proposalLaw, prefixParserDisagreementMass, traceLaw,
    eventMass_mapDistribution] using comparison

/-- A protocol parser is first-token sufficient when its proposal is fully
    determined by the first generated token. This is a strong, explicit
    restriction on an application protocol; it is not assumed for general
    structured outputs. -/
structure FirstTokenSufficientParser
    {Context Token Proposal : Type}
    (constitution : AutoregressiveConstitution Context Token Proposal) where
  parseFirstToken : Option Token → Proposal
  factorsThroughFirstToken : ∀ {budget : Nat}
    (trace : BudgetedTokenTrace Token budget),
    constitution.parseProposal trace = parseFirstToken (firstGeneratedToken trace)

/-- If a protocol commits its proposal from the first token alone, changing a
    positive generation budget at a fixed prompt cannot change the proposal
    law. This is the action-level consequence of autoregressive prefix
    invariance. It does not apply when the parser reads a suffix, or when the
    prompt, token kernel, stopping rule, or parser itself changes. -/
theorem first_token_sufficient_parser_proposal_law_budget_invariant
    {Context Token Proposal : Type}
    (constitution : AutoregressiveConstitution Context Token Proposal)
    (parser : FirstTokenSufficientParser constitution)
    (context : Context) (firstBudget secondBudget : Nat)
    (firstBudgetPositive : 0 < firstBudget)
    (secondBudgetPositive : 0 < secondBudget) :
    ∀ event : Proposal → Bool,
      eventMass (proposalLaw constitution context firstBudget) event =
        eventMass (proposalLaw constitution context secondBudget) event := by
  intro event
  let firstTrace := generatedTokenTrace constitution.nextToken constitution.stopToken
    firstBudget (constitution.prompt context)
  let secondTrace := generatedTokenTrace constitution.nextToken constitution.stopToken
    secondBudget (constitution.prompt context)
  calc
    eventMass (proposalLaw constitution context firstBudget) event =
        eventMass firstTrace (fun trace => event (constitution.parseProposal trace)) := by
          exact eventMass_mapDistribution constitution.parseProposal firstTrace event
    _ = eventMass firstTrace
        (fun trace => event (parser.parseFirstToken (firstGeneratedToken trace))) := by
          apply congrArg
          funext trace
          rw [parser.factorsThroughFirstToken]
    _ = eventMass (mapDistribution firstGeneratedToken firstTrace)
        (fun token => event (parser.parseFirstToken token)) := by
          symm
          exact eventMass_mapDistribution firstGeneratedToken firstTrace
            (fun token => event (parser.parseFirstToken token))
    _ = eventMass (mapDistribution firstGeneratedToken secondTrace)
        (fun token => event (parser.parseFirstToken token)) :=
          first_token_law_independent_of_positive_budget constitution.nextToken
            constitution.stopToken firstBudget (constitution.prompt context)
            firstBudgetPositive (fun token => event (parser.parseFirstToken token)) |>.trans
              (first_token_law_independent_of_positive_budget constitution.nextToken
                constitution.stopToken secondBudget (constitution.prompt context)
                secondBudgetPositive (fun token => event (parser.parseFirstToken token))).symm
    _ = eventMass secondTrace
        (fun trace => event (parser.parseFirstToken (firstGeneratedToken trace))) :=
          eventMass_mapDistribution firstGeneratedToken secondTrace
            (fun token => event (parser.parseFirstToken token))
    _ = eventMass secondTrace (fun trace => event (constitution.parseProposal trace)) := by
          apply congrArg
          funext trace
          rw [parser.factorsThroughFirstToken]
    _ = eventMass (proposalLaw constitution context secondBudget) event := by
          exact (eventMass_mapDistribution constitution.parseProposal secondTrace event).symm

/-- A prefix-sufficient protocol commits its proposal using only the first
    `prefixLength` generated tokens. If both resource budgets cover that prefix,
    changing the maximum horizon cannot change any proposal-event probability.
    This generalizes the first-token special case and is empirically testable by
    varying only the output cap while holding the prompt and decoding fixed. -/
structure PrefixSufficientParser
    {Context Token Proposal : Type}
    (constitution : AutoregressiveConstitution Context Token Proposal)
    (prefixLength : Nat) where
  parsePrefix : List Token → Proposal
  factorsThroughPrefix : ∀ {budget : Nat}
    (trace : BudgetedTokenTrace Token budget),
    constitution.parseProposal trace = parsePrefix (trace.tokens.take prefixLength)

theorem prefix_sufficient_parser_proposal_law_invariant
    {Context Token Proposal : Type}
    (constitution : AutoregressiveConstitution Context Token Proposal)
    (prefixLength : Nat)
    (parser : PrefixSufficientParser constitution prefixLength)
    (context : Context) (firstBudget secondBudget : Nat)
    (firstCoversPrefix : prefixLength ≤ firstBudget)
    (secondCoversPrefix : prefixLength ≤ secondBudget) :
    ∀ event : Proposal → Bool,
      eventMass (proposalLaw constitution context firstBudget) event =
        eventMass (proposalLaw constitution context secondBudget) event := by
  intro event
  let firstTrace := generatedTokenTrace constitution.nextToken constitution.stopToken
    firstBudget (constitution.prompt context)
  let secondTrace := generatedTokenTrace constitution.nextToken constitution.stopToken
    secondBudget (constitution.prompt context)
  let prefixLaw (budget : Nat) := mapDistribution
    (fun trace => trace.tokens.take prefixLength)
    (generatedTokenTrace constitution.nextToken constitution.stopToken budget
      (constitution.prompt context))
  calc
    eventMass (proposalLaw constitution context firstBudget) event =
        eventMass firstTrace (fun trace => event (constitution.parseProposal trace)) := by
          exact eventMass_mapDistribution constitution.parseProposal firstTrace event
    _ = eventMass firstTrace
        (fun trace => event (parser.parsePrefix (trace.tokens.take prefixLength))) := by
          apply congrArg
          funext trace
          rw [parser.factorsThroughPrefix]
    _ = eventMass (prefixLaw firstBudget)
        (fun prefixTokens => event (parser.parsePrefix prefixTokens)) := by
          unfold prefixLaw
          symm
          exact eventMass_mapDistribution
            (fun trace => trace.tokens.take prefixLength) firstTrace
            (fun prefixTokens => event (parser.parsePrefix prefixTokens))
    _ = eventMass (prefixLaw secondBudget)
        (fun prefixTokens => event (parser.parsePrefix prefixTokens)) := by
          unfold prefixLaw
          calc
            eventMass
                (mapDistribution (fun trace => trace.tokens.take prefixLength)
                  (generatedTokenTrace constitution.nextToken constitution.stopToken
                    firstBudget (constitution.prompt context)))
                (fun prefixTokens => event (parser.parsePrefix prefixTokens)) =
              eventMass
                (mapDistribution (fun trace => trace.tokens.take prefixLength)
                  (generatedTokenTrace constitution.nextToken constitution.stopToken
                    prefixLength (constitution.prompt context)))
                (fun prefixTokens => event (parser.parsePrefix prefixTokens)) :=
                  token_prefix_law_independent_of_larger_budget
                    constitution.nextToken constitution.stopToken prefixLength firstBudget
                    (constitution.prompt context) firstCoversPrefix
                    (fun prefixTokens => event (parser.parsePrefix prefixTokens))
            _ = eventMass
                (mapDistribution (fun trace => trace.tokens.take prefixLength)
                  (generatedTokenTrace constitution.nextToken constitution.stopToken
                    secondBudget (constitution.prompt context)))
                (fun prefixTokens => event (parser.parsePrefix prefixTokens)) :=
                  (token_prefix_law_independent_of_larger_budget
                    constitution.nextToken constitution.stopToken prefixLength secondBudget
                    (constitution.prompt context) secondCoversPrefix
                    (fun prefixTokens => event (parser.parsePrefix prefixTokens))).symm
    _ = eventMass secondTrace
        (fun trace => event (parser.parsePrefix (trace.tokens.take prefixLength))) := by
          unfold prefixLaw
          exact eventMass_mapDistribution
            (fun trace => trace.tokens.take prefixLength) secondTrace
            (fun prefixTokens => event (parser.parsePrefix prefixTokens))
    _ = eventMass secondTrace
        (fun trace => event (constitution.parseProposal trace)) := by
          apply congrArg
          funext trace
          rw [parser.factorsThroughPrefix]
    _ = eventMass (proposalLaw constitution context secondBudget) event := by
          exact (eventMass_mapDistribution constitution.parseProposal secondTrace event).symm

/-- Quantitative budget-sensitivity bound for an arbitrary parser. A common
    prefix-only decoder has exactly the same event law at both budgets; each
    full parser can depart from that decoder only on its trace-disagreement
    event. Therefore any action probability shift is bounded in both directions
    by the sum of those two disagreement probabilities. This predicts no sign
    of the resource effect, but it can rule out large effects when parsing is
    empirically prefix-stable. -/
theorem proposal_event_budget_sensitivity_bounded_by_prefix_disagreement
    {Context Token Proposal : Type} [DecidableEq Proposal]
    (constitution : AutoregressiveConstitution Context Token Proposal)
    (context : Context) (firstBudget secondBudget prefixLength : Nat)
    (prefixParser : List Token → Proposal)
    (firstCoversPrefix : prefixLength ≤ firstBudget)
    (secondCoversPrefix : prefixLength ≤ secondBudget)
    (event : Proposal → Bool) :
    (eventMass (proposalLaw constitution context firstBudget) event ≤
        eventMass (proposalLaw constitution context secondBudget) event +
          prefixParserDisagreementMass constitution context firstBudget prefixLength
            prefixParser +
          prefixParserDisagreementMass constitution context secondBudget prefixLength
            prefixParser) ∧
      (eventMass (proposalLaw constitution context secondBudget) event ≤
        eventMass (proposalLaw constitution context firstBudget) event +
          prefixParserDisagreementMass constitution context firstBudget prefixLength
            prefixParser +
          prefixParserDisagreementMass constitution context secondBudget prefixLength
            prefixParser) := by
  let firstPrefixLaw := mapDistribution prefixParser
    (mapDistribution (fun trace : BudgetedTokenTrace Token firstBudget =>
      trace.tokens.take prefixLength)
      (generatedTokenTrace constitution.nextToken constitution.stopToken firstBudget
        (constitution.prompt context)))
  let secondPrefixLaw := mapDistribution prefixParser
    (mapDistribution (fun trace : BudgetedTokenTrace Token secondBudget =>
      trace.tokens.take prefixLength)
      (generatedTokenTrace constitution.nextToken constitution.stopToken secondBudget
        (constitution.prompt context)))
  have prefixLawEqual : eventMass firstPrefixLaw event = eventMass secondPrefixLaw event := by
    calc
      eventMass firstPrefixLaw event =
          eventMass
            (mapDistribution (fun trace : BudgetedTokenTrace Token firstBudget =>
              trace.tokens.take prefixLength)
              (generatedTokenTrace constitution.nextToken constitution.stopToken firstBudget
                (constitution.prompt context)))
            (fun prefixValue => event (prefixParser prefixValue)) :=
              eventMass_mapDistribution prefixParser _ event
      _ = eventMass
            (mapDistribution (fun trace : BudgetedTokenTrace Token secondBudget =>
              trace.tokens.take prefixLength)
              (generatedTokenTrace constitution.nextToken constitution.stopToken secondBudget
                (constitution.prompt context)))
            (fun prefixValue => event (prefixParser prefixValue)) :=
              token_prefix_law_independent_of_larger_budget
                constitution.nextToken constitution.stopToken prefixLength firstBudget
                (constitution.prompt context) firstCoversPrefix
                (fun prefixValue => event (prefixParser prefixValue)) |>.trans
                  (token_prefix_law_independent_of_larger_budget
                    constitution.nextToken constitution.stopToken prefixLength secondBudget
                    (constitution.prompt context) secondCoversPrefix
                    (fun prefixValue => event (prefixParser prefixValue))).symm
      _ = eventMass secondPrefixLaw event := by
            exact (eventMass_mapDistribution prefixParser _ event).symm
  have firstApprox :=
    proposal_event_within_prefix_parser_disagreement constitution context firstBudget
      prefixLength prefixParser event
  have secondApprox :=
    proposal_event_within_prefix_parser_disagreement constitution context secondBudget
      prefixLength prefixParser event
  refine ⟨?_, ?_⟩
  · calc
      eventMass (proposalLaw constitution context firstBudget) event ≤
          eventMass firstPrefixLaw event +
            prefixParserDisagreementMass constitution context firstBudget prefixLength
              prefixParser := by
                simpa [firstPrefixLaw] using firstApprox.1
      _ = eventMass secondPrefixLaw event +
            prefixParserDisagreementMass constitution context firstBudget prefixLength
              prefixParser := by rw [prefixLawEqual]
      _ ≤ eventMass (proposalLaw constitution context secondBudget) event +
            prefixParserDisagreementMass constitution context secondBudget prefixLength
              prefixParser +
            prefixParserDisagreementMass constitution context firstBudget prefixLength
              prefixParser := by
                exact Rat.add_le_add_right.mpr secondApprox.2
      _ = eventMass (proposalLaw constitution context secondBudget) event +
            prefixParserDisagreementMass constitution context firstBudget prefixLength
              prefixParser +
            prefixParserDisagreementMass constitution context secondBudget prefixLength
              prefixParser := by ac_rfl
  · calc
      eventMass (proposalLaw constitution context secondBudget) event ≤
          eventMass secondPrefixLaw event +
            prefixParserDisagreementMass constitution context secondBudget prefixLength
              prefixParser := by
                simpa [secondPrefixLaw] using secondApprox.1
      _ = eventMass firstPrefixLaw event +
            prefixParserDisagreementMass constitution context secondBudget prefixLength
              prefixParser := by rw [prefixLawEqual.symm]
      _ ≤ eventMass (proposalLaw constitution context firstBudget) event +
            prefixParserDisagreementMass constitution context firstBudget prefixLength
              prefixParser +
            prefixParserDisagreementMass constitution context secondBudget prefixLength
              prefixParser := by
                exact Rat.add_le_add_right.mpr firstApprox.2
      _ = eventMass (proposalLaw constitution context firstBudget) event +
            prefixParserDisagreementMass constitution context firstBudget prefixLength
              prefixParser +
            prefixParserDisagreementMass constitution context secondBudget prefixLength
              prefixParser := by ac_rfl

/-- Optional empirical refinement connecting an agent-economy model's response
    kernel to an autoregressive implementation. For each tracked agent,
    constitution fixes the token kernel, parser, and generation budget; the
    complete visible model input is encoded as the initial prompt prefix.
    `responseFactorization` is a model restriction to be checked against the
    implementation, not a theorem about arbitrary LLM systems. -/
structure ResponseKernelRepresentation
    {Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Proposal Production : Type}
    [DecidableEq Proposal]
    (model : AgentEconomyModel Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Proposal Production) where
  Token : Type
  generationBudget : Agent → AgentState InternalState ResourceState → Nat
  prompt : Agent → Condition → AgentState InternalState ResourceState →
    Observation → InstitutionalSignal → List Opportunity → List Token
  nextToken : Agent → NextTokenKernel Token
  stopToken : Agent → Token → Bool
  parseProposal : Agent → {budget : Nat} → BudgetedTokenTrace Token budget → Proposal
  responseFactorization : ∀ agent condition state observation signal menu,
    model.individualResponse agent condition state observation signal menu =
      mapDistribution (parseProposal agent)
        (generatedTokenTrace (nextToken agent) (stopToken agent)
          (generationBudget agent state)
          (prompt agent condition state observation signal menu))

/-- Application-level parser restriction for an economy response kernel. It
    says that the economic proposal is determined by the first generated token
    for each tracked subject. This can be checked against a protocol; it is
    not a general property of language-model outputs. -/
structure FirstTokenSufficientResponseParser
    {Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Proposal Production : Type}
    [DecidableEq Proposal]
    {model : AgentEconomyModel Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Proposal Production}
    (representation : ResponseKernelRepresentation model) where
  parseFirstToken : Agent → Option representation.Token → Proposal
  factorsThroughFirstToken : ∀ agent {budget : Nat}
    (trace : BudgetedTokenTrace representation.Token budget),
    representation.parseProposal agent trace =
      parseFirstToken agent (firstGeneratedToken trace)

/-- Economy-level consequence of first-token sufficiency: if two states of the
    same subject encode the same prompt but induce different positive resource
    budgets, their individual proposal event probabilities are identical.
    Thus, under this protocol restriction, any economic response difference
    must enter through the prompt/state encoding or a change in computational
    constitution, not through the maximum horizon alone. -/
theorem first_token_sufficient_response_law_invariant_across_states
    {Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Proposal Production : Type}
    [DecidableEq Proposal]
    {model : AgentEconomyModel Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Proposal Production}
    (representation : ResponseKernelRepresentation model)
    (parser : FirstTokenSufficientResponseParser representation)
    (agent : Agent)
    (condition₁ condition₂ : Condition)
    (state₁ state₂ : AgentState InternalState ResourceState)
    (observation₁ observation₂ : Observation)
    (signal₁ signal₂ : InstitutionalSignal)
    (menu₁ menu₂ : List Opportunity)
    (samePrompt : representation.prompt agent condition₁ state₁ observation₁ signal₁ menu₁ =
      representation.prompt agent condition₂ state₂ observation₂ signal₂ menu₂)
    (positiveBudget₁ : 0 < representation.generationBudget agent state₁)
    (positiveBudget₂ : 0 < representation.generationBudget agent state₂) :
    ∀ event : Proposal → Bool,
      eventMass
        (model.individualResponse agent condition₁ state₁ observation₁ signal₁ menu₁) event =
      eventMass
        (model.individualResponse agent condition₂ state₂ observation₂ signal₂ menu₂) event := by
  intro event
  rw [representation.responseFactorization agent condition₁ state₁ observation₁ signal₁ menu₁,
    representation.responseFactorization agent condition₂ state₂ observation₂ signal₂ menu₂,
    eventMass_mapDistribution, eventMass_mapDistribution]
  have firstParserEq :
      (fun trace : BudgetedTokenTrace representation.Token
        (representation.generationBudget agent state₁) =>
          event (representation.parseProposal agent trace)) =
      (fun trace => event (parser.parseFirstToken agent (firstGeneratedToken trace))) := by
    funext trace
    rw [parser.factorsThroughFirstToken]
  have secondParserEq :
      (fun trace : BudgetedTokenTrace representation.Token
        (representation.generationBudget agent state₂) =>
          event (representation.parseProposal agent trace)) =
      (fun trace => event (parser.parseFirstToken agent (firstGeneratedToken trace))) := by
    funext trace
    rw [parser.factorsThroughFirstToken]
  rw [firstParserEq, secondParserEq]
  let firstTrace := generatedTokenTrace (representation.nextToken agent)
    (representation.stopToken agent) (representation.generationBudget agent state₁)
    (representation.prompt agent condition₁ state₁ observation₁ signal₁ menu₁)
  let secondTrace := generatedTokenTrace (representation.nextToken agent)
    (representation.stopToken agent) (representation.generationBudget agent state₂)
    (representation.prompt agent condition₂ state₂ observation₂ signal₂ menu₂)
  calc
    eventMass firstTrace
        (fun trace => event (parser.parseFirstToken agent
          (firstGeneratedToken trace))) =
      eventMass (mapDistribution firstGeneratedToken firstTrace)
        (fun token => event (parser.parseFirstToken agent token)) := by
          symm
          exact eventMass_mapDistribution firstGeneratedToken firstTrace
            (fun token => event (parser.parseFirstToken agent token))
    _ = eventMass (mapDistribution firstGeneratedToken secondTrace)
          (fun token => event (parser.parseFirstToken agent token)) := by
            calc
              eventMass (mapDistribution firstGeneratedToken firstTrace)
                  (fun token => event (parser.parseFirstToken agent token)) =
                eventMass (mapDistribution some
                  (representation.nextToken agent
                    (representation.prompt agent condition₁ state₁ observation₁ signal₁ menu₁)))
                  (fun token => event (parser.parseFirstToken agent token)) :=
                    first_token_law_independent_of_positive_budget
                      (representation.nextToken agent) (representation.stopToken agent)
                      (representation.generationBudget agent state₁)
                      (representation.prompt agent condition₁ state₁ observation₁ signal₁ menu₁)
                      positiveBudget₁ (fun token => event (parser.parseFirstToken agent token))
              _ = eventMass (mapDistribution some
                  (representation.nextToken agent
                    (representation.prompt agent condition₂ state₂ observation₂ signal₂ menu₂)))
                  (fun token => event (parser.parseFirstToken agent token)) := by
                    rw [samePrompt]
              _ = eventMass (mapDistribution firstGeneratedToken secondTrace)
                  (fun token => event (parser.parseFirstToken agent token)) :=
                    (first_token_law_independent_of_positive_budget
                      (representation.nextToken agent) (representation.stopToken agent)
                      (representation.generationBudget agent state₂)
                      (representation.prompt agent condition₂ state₂ observation₂ signal₂ menu₂)
                      positiveBudget₂ (fun token => event (parser.parseFirstToken agent token))).symm
    _ = eventMass secondTrace
        (fun trace => event (parser.parseFirstToken agent
          (firstGeneratedToken trace))) :=
          eventMass_mapDistribution firstGeneratedToken secondTrace
            (fun token => event (parser.parseFirstToken agent token))

/-- For one fixed computational subject, changing the resource-conditioned
    generation horizon while holding the complete prompt fixed cannot change
    the first-token marginal. This is a falsifiable implication of the
    autoregressive constitution, not a monotonicity claim about full actions:
    budget changes may alter later tokens and any parser decision that depends
    on the generated suffix. -/
theorem same_prompt_preserves_first_token_law_across_resource_budgets
    {Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Proposal Production : Type}
    [DecidableEq Proposal]
    {model : AgentEconomyModel Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Proposal Production}
    (representation : ResponseKernelRepresentation model)
    (agent : Agent)
    (condition₁ condition₂ : Condition)
    (state₁ state₂ : AgentState InternalState ResourceState)
    (observation₁ observation₂ : Observation)
    (signal₁ signal₂ : InstitutionalSignal)
    (menu₁ menu₂ : List Opportunity)
    (samePrompt : representation.prompt agent condition₁ state₁ observation₁ signal₁ menu₁ =
      representation.prompt agent condition₂ state₂ observation₂ signal₂ menu₂)
    (positiveBudget₁ : 0 < representation.generationBudget agent state₁)
    (positiveBudget₂ : 0 < representation.generationBudget agent state₂) :
    ∀ event : Option representation.Token → Bool,
      eventMass
        (mapDistribution firstGeneratedToken
          (generatedTokenTrace (representation.nextToken agent)
            (representation.stopToken agent)
            (representation.generationBudget agent state₁)
            (representation.prompt agent condition₁ state₁ observation₁ signal₁ menu₁))) event =
      eventMass
        (mapDistribution firstGeneratedToken
          (generatedTokenTrace (representation.nextToken agent)
            (representation.stopToken agent)
            (representation.generationBudget agent state₂)
            (representation.prompt agent condition₂ state₂ observation₂ signal₂ menu₂))) event := by
  intro event
  calc
    eventMass
        (mapDistribution firstGeneratedToken
          (generatedTokenTrace (representation.nextToken agent)
            (representation.stopToken agent)
            (representation.generationBudget agent state₁)
            (representation.prompt agent condition₁ state₁ observation₁ signal₁ menu₁))) event =
      eventMass (mapDistribution some
        (representation.nextToken agent
          (representation.prompt agent condition₁ state₁ observation₁ signal₁ menu₁))) event :=
      first_token_law_independent_of_positive_budget
        (representation.nextToken agent) (representation.stopToken agent)
        (representation.generationBudget agent state₁)
        (representation.prompt agent condition₁ state₁ observation₁ signal₁ menu₁)
        positiveBudget₁ event
    _ = eventMass (mapDistribution some
        (representation.nextToken agent
          (representation.prompt agent condition₂ state₂ observation₂ signal₂ menu₂))) event := by
      rw [samePrompt]
    _ = eventMass
        (mapDistribution firstGeneratedToken
          (generatedTokenTrace (representation.nextToken agent)
            (representation.stopToken agent)
            (representation.generationBudget agent state₂)
            (representation.prompt agent condition₂ state₂ observation₂ signal₂ menu₂))) event :=
      (first_token_law_independent_of_positive_budget
        (representation.nextToken agent) (representation.stopToken agent)
        (representation.generationBudget agent state₂)
        (representation.prompt agent condition₂ state₂ observation₂ signal₂ menu₂)
        positiveBudget₂ event).symm

/-- Holding the token-generating constitution and parser fixed, equal complete
    prompt prefixes imply equal proposal laws for every finite generation
    budget. Thus any proposal-law difference under a fixed constitution must
    enter through a different encoded prompt/context. -/
theorem equal_prompt_implies_equal_proposal_law
    {Context Token Proposal : Type}
    (constitution : AutoregressiveConstitution Context Token Proposal)
    (first second : Context) (generationBudget : Nat)
    (samePrompt : constitution.prompt first = constitution.prompt second) :
    proposalLaw constitution first generationBudget =
      proposalLaw constitution second generationBudget := by
  unfold proposalLaw
  rw [samePrompt]

/-- Contrapositive identification boundary: with the same fixed constitution,
    parser, and generation budget, different proposal laws require different
    encoded prompts. Different prompts alone do not imply different actions;
    the token kernel and parser may map them to the same proposal law. -/
theorem different_proposal_law_requires_different_prompt
    {Context Token Proposal : Type}
    (constitution : AutoregressiveConstitution Context Token Proposal)
    (first second : Context) (generationBudget : Nat)
    (differentLaws : proposalLaw constitution first generationBudget ≠
      proposalLaw constitution second generationBudget) :
    constitution.prompt first ≠ constitution.prompt second := by
  intro samePrompt
  exact differentLaws
    (equal_prompt_implies_equal_proposal_law constitution first second
      generationBudget samePrompt)

/-- Under a represented autoregressive response process, two model conditions
    that produce the same complete prompt for the same tracked agent yield the
    same individual proposal law. This links computational context to the
    agent-level behavioral object without a preference or rationality axiom. -/
theorem equal_encoded_input_implies_equal_model_response
    {Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Proposal Production : Type}
    [DecidableEq Proposal]
    {model : AgentEconomyModel Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Proposal Production}
    (representation : ResponseKernelRepresentation model)
    (agent : Agent)
    (condition₁ condition₂ : Condition)
    (state₁ state₂ : AgentState InternalState ResourceState)
    (observation₁ observation₂ : Observation)
    (signal₁ signal₂ : InstitutionalSignal)
    (menu₁ menu₂ : List Opportunity)
    (sameBudget : representation.generationBudget agent state₁ =
      representation.generationBudget agent state₂)
    (samePrompt : representation.prompt agent condition₁ state₁ observation₁ signal₁ menu₁ =
      representation.prompt agent condition₂ state₂ observation₂ signal₂ menu₂) :
    model.individualResponse agent condition₁ state₁ observation₁ signal₁ menu₁ =
      model.individualResponse agent condition₂ state₂ observation₂ signal₂ menu₂ := by
  rw [representation.responseFactorization agent condition₁ state₁ observation₁ signal₁ menu₁,
    representation.responseFactorization agent condition₂ state₂ observation₂ signal₂ menu₂,
    sameBudget, samePrompt]

/-- Under a fixed autoregressive constitution and parser, a change in the
    individual proposal law requires a change in at least one encoded dynamic
    input: either the complete prompt prefix or the state-conditioned token
    budget. This is a necessary-condition result, not a claim that either input
    change must alter behavior or that it identifies which feature caused it. -/
theorem different_model_response_requires_prompt_or_budget_change
    {Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Proposal Production : Type}
    [DecidableEq Proposal]
    {model : AgentEconomyModel Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Proposal Production}
    (representation : ResponseKernelRepresentation model)
    (agent : Agent)
    (condition₁ condition₂ : Condition)
    (state₁ state₂ : AgentState InternalState ResourceState)
    (observation₁ observation₂ : Observation)
    (signal₁ signal₂ : InstitutionalSignal)
    (menu₁ menu₂ : List Opportunity)
    (differentResponses :
      model.individualResponse agent condition₁ state₁ observation₁ signal₁ menu₁ ≠
        model.individualResponse agent condition₂ state₂ observation₂ signal₂ menu₂) :
    representation.generationBudget agent state₁ ≠
        representation.generationBudget agent state₂ ∨
      representation.prompt agent condition₁ state₁ observation₁ signal₁ menu₁ ≠
        representation.prompt agent condition₂ state₂ observation₂ signal₂ menu₂ := by
  by_cases sameBudget : representation.generationBudget agent state₁ =
      representation.generationBudget agent state₂
  · by_cases samePrompt : representation.prompt agent condition₁ state₁ observation₁ signal₁ menu₁ =
        representation.prompt agent condition₂ state₂ observation₂ signal₂ menu₂
    · exact False.elim (differentResponses
        (equal_encoded_input_implies_equal_model_response representation agent
          condition₁ condition₂ state₁ state₂ observation₁ observation₂ signal₁ signal₂
          menu₁ menu₂ sameBudget samePrompt))
    · exact Or.inr samePrompt
  · exact Or.inl sameBudget

end AgentMicrofoundations.AutoregressiveResponse
