import AgentMicrofoundations.Ontology

/-!
Finite-horizon agent-economy paths. The state may include the condition or
context that changes an agent's response law. Each period uses a model and an
explicitly compatible institution; the next-context kernel is conditional on
the complete period outcome, so no independence assumption is introduced.
-/
namespace AgentMicrofoundations.FiniteDynamics

open AgentMicrofoundations.Ontology

abbrev PeriodOutcome (Agent InternalState ResourceState Opportunity Proposal Production : Type) :=
  ProposalProfile Agent Proposal × ExecutionProfile Agent Opportunity ×
    ProductionProfile Agent Production × StateProfile Agent InternalState ResourceState

/-- Add a context-generation kernel after the agent economy's within-period
    response, execution, production, and state update. Since it is conditional
    on the full outcome, context persistence may be correlated with production
    and with all agents' actions. -/
def contextConditionedTransition
    {Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Proposal Production : Type}
    [DecidableEq Proposal]
    (model : AgentEconomyModel Agent InternalState ResourceState Condition Observation InstitutionalSignal Opportunity Proposal Production)
    (institution : AdmissibleInstitution model)
    (contextKernel : Condition → StateProfile Agent InternalState ResourceState →
      PeriodOutcome Agent InternalState ResourceState Opportunity Proposal Production →
        FiniteDistribution Condition) :
    (Condition × StateProfile Agent InternalState ResourceState) →
      FiniteDistribution
        (PeriodOutcome Agent InternalState ResourceState Opportunity Proposal Production ×
          (Condition × StateProfile Agent InternalState ResourceState)) := by
  intro current
  exact bindDistribution
    (admissibleOnePeriodDistribution model institution current.1 current.2)
    (fun outcome =>
      mapDistribution
        (fun nextCondition => (outcome, (nextCondition, outcome.2.2.2)))
        (contextKernel current.1 current.2 outcome))

/-- Distribution of an ordered finite trajectory generated by a state
    transition kernel. `steps = 0` returns the initial state and an empty trace.
    Later steps prepend each realized period outcome to the continuation path. -/
def trajectoryDistribution {State Observation : Type}
    (transition : State → FiniteDistribution (Observation × State)) :
    Nat → State → FiniteDistribution (List Observation × State)
  | 0, state => pureDistribution ([], state)
  | steps + 1, state =>
      bindDistribution (transition state) (fun step =>
        mapDistribution
          (fun continuation => (step.1 :: continuation.1, continuation.2))
          (trajectoryDistribution transition steps step.2))

/-- A finite path is supported when each realized period has positive
    conditional support under the transition kernel. This path relation carries
    no factorization assumption about the internal population outcome. -/
inductive SupportedTrajectory {State Observation : Type}
    (transition : State → FiniteDistribution (Observation × State)) :
    Nat → State → State → List Observation → Prop where
  | nil (state : State) :
      SupportedTrajectory transition 0 state state []
  | cons {steps : Nat} {state nextState finalState : State}
      {observation : Observation} {tail : List Observation}
      (stepSupported : Supports (transition state) (observation, nextState))
      (continuation : SupportedTrajectory transition steps nextState finalState tail) :
      SupportedTrajectory transition (steps + 1) state finalState
        (observation :: tail)

/-- Every stepwise-supported path has positive mass in the finite-horizon
    trajectory distribution. This is the finite-horizon chain rule stated in
    terms of exact support; numerical path probabilities remain products of
    the conditional weights. -/
theorem supported_trajectory_has_positive_mass
    {State Observation : Type}
    (transition : State → FiniteDistribution (Observation × State))
    {steps : Nat} {initial finalState : State} {observations : List Observation}
    (supported : SupportedTrajectory transition steps initial finalState observations) :
    Supports (trajectoryDistribution transition steps initial)
      (observations, finalState) := by
  induction supported with
  | nil state =>
      refine ⟨1, ?_, Rat.natCast_pos.mpr Nat.zero_lt_one⟩
      simp [trajectoryDistribution, pureDistribution]
  | cons stepSupported continuation ih =>
      rename_i steps state nextState finalState observation tail
      have mappedContinuation := supports_mapDistribution_of_supports
        (fun continuation => (observation :: continuation.1, continuation.2))
        (trajectoryDistribution transition steps nextState)
        (tail, finalState) ih
      exact supports_bindDistribution_of_supports (transition state)
        (fun step => mapDistribution
          (fun continuation => (step.1 :: continuation.1, continuation.2))
          (trajectoryDistribution transition steps step.2))
        (observation, nextState) (observation :: tail, finalState)
        stepSupported mappedContinuation

/-- Run a finite-horizon trajectory from an initial state lottery. -/
def trajectoryFromInitial {State Observation : Type}
    (transition : State → FiniteDistribution (Observation × State))
    (initialStates : FiniteDistribution State) (steps : Nat) :
    FiniteDistribution (List Observation × State) :=
  bindDistribution initialStates (fun state =>
    trajectoryDistribution transition steps state)

/-- A positive-support initial state followed by a stepwise-supported path
    gives positive probability under the initial finite-horizon process law. -/
theorem initial_support_and_supported_trajectory_have_positive_mass
    {State Observation : Type}
    (transition : State → FiniteDistribution (Observation × State))
    (initialStates : FiniteDistribution State)
    {steps : Nat} {initial finalState : State} {observations : List Observation}
    (initialSupported : Supports initialStates initial)
    (pathSupported :
      SupportedTrajectory transition steps initial finalState observations) :
    Supports (trajectoryFromInitial transition initialStates steps)
      (observations, finalState) := by
  exact supports_bindDistribution_of_supports initialStates
    (fun state => trajectoryDistribution transition steps state)
    initial (observations, finalState) initialSupported
    (supported_trajectory_has_positive_mass transition pathSupported)

end AgentMicrofoundations.FiniteDynamics
